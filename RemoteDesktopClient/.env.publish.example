# Values baked into AppSettingsFactory.cs by ../publish.ps1 for a portable,
# self-contained single-file publish meant to be handed to a real end user
# (double-click RemoteConnect.exe - no .NET, no FFmpeg, no installer). This is
# a SEPARATE profile from .env.release, which ../release.ps1 uses for the
# existing multi-file Hyper-V VM test-deployment workflow (see
# client/scripts/deploy-to-vm.ps1) - the two can point at different backends
# and are published by different scripts, but are read by the exact same
# tools/ReleaseConfigGenerator mechanism.
#
# Like .env.release, this file is never read by the app itself - only by
# publish.ps1, at build time. The published app does not need this file,
# .env, .env.release, or any environment variable present.
#
# Copy this to .env.publish and fill in the real production target before
# publishing a build for real distribution.
DEVICE_WS_URL=wss://your-production-backend.example.com/api/ws/device

# WebRTC ICE servers (see RemoteDesktopClient/WebRTC/WebRtcSessionManager.cs).
# Every AppSettings property - these four included - must have a matching
# key in this file, even if left blank (see ReleaseConfigGenerator, which
# fails the build on a missing key regardless of type). A blank value here
# genuinely means "not configured" - WebRtcSessionManager treats it exactly
# like an unset local .env value (no STUN/TURN, host candidates only), it is
# NOT an error.
#
# IMPORTANT: every value in this file is baked into the published binary as a
# compiled string literal (see tools/ReleaseConfigGenerator) - there is no
# runtime file or environment-variable read to keep it out of the shipped
# exe. Do NOT put a real, long-lived TURN_CREDENTIAL (or any other
# long-lived secret) here for a build that will actually be distributed to
# end users - it would be trivially recoverable from the binary (e.g. via
# `strings` or a decompiler). Leave these blank unless you're using a
# STUN-only or unauthenticated TURN setup; a real TURN deployment needs a
# short-lived, per-session credential minted by the backend at connect time,
# which is backend work and out of scope for this publish workflow. Do not
# put real credentials in this .example file or commit them anywhere.
STUN_SERVER_URL=
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Ceiling (kbps) applied to the outgoing screen-share video bitrate
# UNCONDITIONALLY - direct/P2P and TURN/relay connections alike (see
# VideoBitrateCalculator.ApplyMaxBitrate). 1000 = 1 Mbps - tune per
# deployment's actual bandwidth budget.
MAX_VIDEO_BITRATE_KBPS=1000

# Screen-capture frame rate (see ScreenCaptureFpsCalculator /
# WebRtcSessionManager.TrySetupVideo). SCREEN_CAPTURE_FPS is used as-is for a
# direct/P2P connection; MAX_SCREEN_CAPTURE_FPS caps it ONLY when relayed
# through TURN. Both must be positive (AppSettings validates this).
SCREEN_CAPTURE_FPS=60
MAX_SCREEN_CAPTURE_FPS=15

# Bandwidth ceiling (kbps) for a synced clipboard image (see
# ClipboardImageChunker / ClipboardImageReassembler) - deliberately low by
# default, see .env.example for why. Must be positive.
CLIPBOARD_IMAGE_MAX_BITRATE_KBPS=15

# Per-file size ceiling (MB, 1 MB = 1,048,576 bytes) for a clipboard file
# transfer, applied ONLY when the active connection is relayed through TURN
# (decided from the real nominated ICE pair, not from TURN merely being
# configured). A direct/P2P connection has no file-size limit. Applies
# independently to both directions (target -> requester copy, requester ->
# target paste), checked by the sender before sending AND by the receiver
# against the declared size. Must be positive.
FILE_TRANSFER_MAX_TURN_MB=20

# Temporary debug aid, not a real product feature - see .env.example. Leave
# off for a real end-user distribution.
SHOW_REMOTE_DEBUG=false

# How often RemoteSessionTelemetry samples/logs per-session performance
# metrics - see .env.example. Must be positive.
TELEMETRY_SAMPLE_INTERVAL_SECONDS=1

# Requester-side Recent Connections thumbnail caching - see .env.example.
ENABLE_SESSION_THUMBNAILS=true

# client.log rotation/retention - see .env.example. Both must be positive.
CLIENT_LOG_MAX_FILE_SIZE_MB=10
CLIENT_LOG_MAX_FILES=10

# "owner/repo" the built-in updater checks via GitHub's public Releases API
# (see MainWindow.Update.cs / Services/Update/GitHubUpdateClient) - this is
# the one env file where this actually matters. Each release must upload
# TWO assets, both produced by this repo's ..\publish.ps1: RemoteConnect.exe
# and RemoteConnect.exe.sha256 (the updater downloads and verifies the
# checksum before trusting the exe - no code-signing certificate exists for
# this project, so this is the practical integrity check). Tag releases as
# vMAJOR.MINOR.PATCH (e.g. v1.1.0) to match RemoteDesktopClient.csproj's
# <Version>.
UPDATE_GITHUB_REPO=owner/repo
