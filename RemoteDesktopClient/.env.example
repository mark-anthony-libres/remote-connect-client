# Backend device-identity WebSocket endpoint
# (backend/apps/app/modules/device/websocket/device_gateway.py).
# Matches the backend's PORT/API_PREFIX defaults — see backend/.env.example.
DEVICE_WS_URL=ws://localhost:8000/api/ws/device

# WebRTC ICE servers (see RemoteDesktopClient/WebRTC/WebRtcSessionManager.cs).
# All four are genuinely optional - leave unset (or delete the lines) for a
# same-machine/same-LAN test with only host ICE candidates. No default STUN/
# TURN server is invented if these are absent; WebRtcSessionManager logs
# "[WebRTC] No STUN server configured" / "No TURN server configured" instead.
# STUN_SERVER_URL=stun:stun.example.com:3478
# TURN_SERVER_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Ceiling (kbps) applied to the outgoing screen-share video bitrate
# UNCONDITIONALLY - direct/P2P and TURN/relay connections alike (see
# VideoBitrateCalculator.ApplyMaxBitrate) - regardless of how high the
# resolution-based bitrate (VideoBitrateCalculator.CalculateKbps) would
# otherwise go. 1000 = 1 Mbps.
MAX_VIDEO_BITRATE_KBPS=1000

# Screen-capture frame rate (see ScreenCaptureFpsCalculator /
# WebRtcSessionManager.TrySetupVideo). SCREEN_CAPTURE_FPS is used as-is for a
# direct/P2P connection; MAX_SCREEN_CAPTURE_FPS caps it ONLY when the active
# connection is relayed through TURN (actual = MIN(SCREEN_CAPTURE_FPS,
# MAX_SCREEN_CAPTURE_FPS) when relayed). Both must be positive.
SCREEN_CAPTURE_FPS=60
MAX_SCREEN_CAPTURE_FPS=15

# Bandwidth ceiling (kbps) for a synced clipboard image (see
# ClipboardImageChunker / ClipboardImageReassembler). Deliberately low by
# default - an image can be several MB and shares the same reliable/ordered
# DataChannel as mouse/keyboard, so an unthrottled transfer could delay
# input delivery behind it for as long as it takes to finish sending. Must
# be positive.
CLIPBOARD_IMAGE_MAX_BITRATE_KBPS=15

# Per-file size ceiling (MB, 1 MB = 1,048,576 bytes) for a clipboard file
# transfer, applied ONLY when the active connection is relayed through TURN
# (decided from the real nominated ICE pair, not from TURN merely being
# configured). A direct/P2P connection has no file-size limit. Applies
# independently to both directions (target -> requester copy, requester ->
# target paste), checked by the sender before sending AND by the receiver
# against the declared size. Must be positive.
FILE_TRANSFER_MAX_TURN_MB=20

# Temporary debug aid, not a real product feature - shows a small overlay
# header on the requester's RemoteSessionWindow with the actually-observed
# video bitrate/fps and whether the connection is direct or relayed through
# TURN (see WebRtcSessionManager.SampleVideoStats). Off by default.
SHOW_REMOTE_DEBUG=false

# How often RemoteSessionTelemetry samples/logs per-session performance
# metrics to logs/remote-sessions/{request_id}.txt (see that class). A
# background sampler interval, never tied to the UI thread or the media hot
# path. Must be positive.
TELEMETRY_SAMPLE_INTERVAL_SECONDS=1

# Whether a requester periodically caches a thumbnail of a target's real
# screen from its own already-decoded video (see MainWindow.SessionWindows.cs/
# DeviceThumbnailCache) for that device's Recent Connections card. On by
# default. Disabling this stops new captures AND hides any thumbnail already
# cached from before - the generic placeholder banner shows instead whenever
# this is off, regardless of what's on disk.
ENABLE_SESSION_THUMBNAILS=true

# client.log rotation/retention (see RotatingFileTraceListener, Program.
# InitialiseFileLogging). Files are named client-{base}-{part}.log under
# logs/ - a new BASE starts every app start/restart, and PART increments
# within that base once the active file reaches CLIENT_LOG_MAX_FILE_SIZE_MB.
# CLIENT_LOG_MAX_FILES caps how many BASEs (not individual part files) are
# kept - the oldest base and all of its part files are deleted once a new
# base would exceed this. Both must be positive.
CLIENT_LOG_MAX_FILE_SIZE_MB=10
CLIENT_LOG_MAX_FILES=10

# "owner/repo" for the built-in updater to check via GitHub's public
# Releases API (see MainWindow.Update.cs / Services/Update/GitHubUpdateClient).
# Optional - blank means the updater never checks, which is what a dev build
# should do. Leave blank here.
UPDATE_GITHUB_REPO=
