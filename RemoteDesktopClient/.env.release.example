# Values baked into AppSettingsFactory.cs by ../release.ps1 for a Release publish.
# Unlike .env (used for local `dotnet run`/Debug), this file is never read by
# the app itself — only by the release script, at build time. The published
# app does not need this file, .env, or any environment variable present.
#
# Copy this to .env.release and fill in the real target before releasing.
DEVICE_WS_URL=wss://your-production-backend.example.com/api/ws/device

# WebRTC ICE servers (see RemoteDesktopClient/WebRTC/WebRtcSessionManager.cs).
# Every AppSettings property - these four included - must have a matching
# key in this file, even if left blank (see ReleaseConfigGenerator, which
# fails the build on a missing key regardless of type). A blank value here
# genuinely means "not configured" - WebRtcSessionManager treats it exactly
# like an unset local .env value (no STUN/TURN, host candidates only), it is
# NOT an error. Leave these blank unless you are actually releasing with a
# real STUN/TURN deployment - do not put real TURN credentials in this
# .example file or commit them anywhere.
STUN_SERVER_URL=
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Ceiling (kbps) applied to the outgoing screen-share video bitrate
# UNCONDITIONALLY - direct/P2P and TURN/relay connections alike (see
# VideoBitrateCalculator.ApplyMaxBitrate). 1000 = 1 Mbps - tune per
# deployment's actual bandwidth budget.
MAX_VIDEO_BITRATE_KBPS=1000

# Screen-capture frame rate (see ScreenCaptureFpsCalculator /
# WebRtcSessionManager.TrySetupVideo). SCREEN_CAPTURE_FPS is used as-is for a
# direct/P2P connection; MAX_SCREEN_CAPTURE_FPS caps it ONLY when relayed
# through TURN. Both must be positive (AppSettings validates this).
SCREEN_CAPTURE_FPS=60
MAX_SCREEN_CAPTURE_FPS=15

# Bandwidth ceiling (kbps) for a synced clipboard image (see
# ClipboardImageChunker / ClipboardImageReassembler) - deliberately low by
# default, see .env.example for why. Must be positive.
CLIPBOARD_IMAGE_MAX_BITRATE_KBPS=15

# Per-file size ceiling (MB, 1 MB = 1,048,576 bytes) for a clipboard file
# transfer, applied ONLY when the active connection is relayed through TURN
# (decided from the real nominated ICE pair, not from TURN merely being
# configured). A direct/P2P connection has no file-size limit. Applies
# independently to both directions (target -> requester copy, requester ->
# target paste), checked by the sender before sending AND by the receiver
# against the declared size. Must be positive.
FILE_TRANSFER_MAX_TURN_MB=20

# Temporary debug aid, not a real product feature - see .env.example. Leave
# off in a real release.
SHOW_REMOTE_DEBUG=false

# How often RemoteSessionTelemetry samples/logs per-session performance
# metrics - see .env.example. Must be positive.
TELEMETRY_SAMPLE_INTERVAL_SECONDS=1

# Requester-side Recent Connections thumbnail caching - see .env.example.
ENABLE_SESSION_THUMBNAILS=true

# client.log rotation/retention - see .env.example. Both must be positive.
CLIENT_LOG_MAX_FILE_SIZE_MB=10
CLIENT_LOG_MAX_FILES=10

# Built-in updater's GitHub repo - see .env.example. Left blank: this VM-test
# workflow's builds never check for updates, only a real ..\..\publish.ps1
# build (.env.publish) does.
UPDATE_GITHUB_REPO=
